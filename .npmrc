# Forward npm script args correctly on Windows Git Bash.
# Without this, npm uses cmd.exe as the script shell and appends the shell
# path to forwarded args (e.g. `npm test -- src/editor` becomes
# `vitest run src/editor:C:\WINDOWS\system32\cmd.exe`), which breaks
# path-style filters. Pinning script-shell to bash keeps arg forwarding clean.
script-shell=C:\\Program Files\\Git\\bin\\bash.exe